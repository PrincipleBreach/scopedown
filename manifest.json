{
  "manifest_version": 3,
  "name": "ScopeDown",
  "version": "1.0.0",
  "description": "Turn HackerOne and Bugcrowd programs into agent-ready Markdown, and let your AI agents work through your logged-in browser over MCP.",
  "author": "Principle Breach",
  "homepage_url": "https://principlebreach.com/?utm_source=scopedown&utm_medium=referral&utm_campaign=extension-details",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ScopeDown: copy this program as Markdown",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://hackerone.com/*",
    "https://bugcrowd.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open ScopeDown on the current program page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scopedown@principlebreach.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
